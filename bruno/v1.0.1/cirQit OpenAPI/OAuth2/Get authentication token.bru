meta {
  name: Get authentication token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/oauth2/token
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  scope: cirqit/read
}

vars:pre-request {
  client_id: xxxxxxxxxxxxxxxxxxxxx
  client_secret: xxxxxxxxxxxxxxxxxxxxx
}
