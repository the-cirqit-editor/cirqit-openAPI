meta {
  name: get the signed URL to upload, download or overwrite a Document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/rest/v1/installation/:resourceId/getDocumentUrl
  body: json
  auth: inherit
}

body:json {
  {
    "documentType": "SCHEMA",
    "fileName":"schema.pdf",
    "action": "UPLOAD"
  }
}
